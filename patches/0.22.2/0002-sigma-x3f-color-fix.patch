+static const struct x3f_sd_model_s *x3f_sd_find(const char *model) {
+  if (!model || !*model)
+    return NULL;
+  const char *m = model;
+  const char *sp = strchr(model, ' ');
+  if (sp && sp[1] && !strncasecmp(model, "SIGMA", 5))
+    m = sp + 1;
+  const unsigned n = sizeof x3f_sd_models / sizeof x3f_sd_models[0];
+  for (unsigned k = 0; k < n; k++)
+    if (!strcasecmp(m, x3f_sd_models[k].model))
+      return &x3f_sd_models[k];
+  return NULL;
+}
+
+static void x3f_sd_transform(const char *model, ushort (*image)[3],
+                             size_t npix) {
+  const struct x3f_sd_model_s *pm = x3f_sd_find(model);
+  if (!pm || !image)
+    return;
+  const double s = 4095.0;
+  const double lift = 2.37841423;
+  for (size_t p = 0; p < npix; p++) {
+    const double r = (double)image[p][0] / s;
+    const double g = (double)image[p][1] / s;
+    const double b = (double)image[p][2] / s;
+    const double basis[9] = {1.0,  r,      g,      b,
+                             r * r, g * g, b * b, r * g,
+                             r * b + g * b};
+    for (int c = 0; c < 3; c++) {
+      double v = 0.0;
+      for (int k = 0; k < 9; k++)
+        v += (double)pm->quad[k][c] * basis[k];
+      v *= lift;
+      if (v < 0.0)
+        v = 0.0;
+      if (v > 16383.0)
+        v = 16383.0;
+      image[p][c] = (ushort)(int)(v + 0.5);
+    }
+  }
+}
